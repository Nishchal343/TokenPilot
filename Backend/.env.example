# Required backend configuration
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/tokenpilot
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10
INVITATION_EXPIRE_DAYS=7

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=notifications@example.com
SMTP_PASSWORD=replace-with-your-smtp-password

# Frontend origin used in invitation links
FRONTEND_URL=http://localhost:5173

# Optional encryption key for stored provider API keys
API_KEY_ENCRYPTION_KEY=

# Optional optimization and cache tuning
TOKENPILOT_MAX_CONTEXT_TOKENS=8192
TOKENPILOT_MIN_CONTEXT_MESSAGES=2
TOKENPILOT_CONTEXT_WEIGHT_SIMILARITY=0.45
TOKENPILOT_CONTEXT_WEIGHT_RECENCY=0.20
TOKENPILOT_CONTEXT_WEIGHT_CODE=0.15
TOKENPILOT_CONTEXT_WEIGHT_DOCUMENTS=0.10
TOKENPILOT_CONTEXT_WEIGHT_FOLLOW_UP=0.10
TOKENPILOT_MAX_DOCUMENT_TOKENS=4096
TOKENPILOT_DOCUMENT_CHUNK_SIZE=1200
TOKENPILOT_DOCUMENT_CHUNK_OVERLAP=120
TOKENPILOT_MAX_RETRIEVED_DOCUMENT_CHUNKS=6
TOKENPILOT_DOCUMENT_SIMILARITY_THRESHOLD=0.05
TOKENPILOT_MAX_CODE_TOKENS=8192
TOKENPILOT_MAX_CODE_FILES=12
TOKENPILOT_CODE_DEPENDENCY_DEPTH=1
TOKENPILOT_CODE_SUPPORTED_LANGUAGES=python,javascript,typescript,java,c,cpp,go,rust,html,css,sql
TOKENPILOT_CODE_IGNORED_DIRECTORIES=node_modules,dist,build,__pycache__,.git,vendor,.next,target
TOKENPILOT_RESPONSE_CACHE_TTL_SECONDS=86400
TOKENPILOT_RESPONSE_CACHE_MAX_ENTRIES=1000
TOKENPILOT_RESPONSE_CACHE_SEMANTIC_THRESHOLD=0.92
TOKENPILOT_RESPONSE_CACHE_PATH=
TOKENPILOT_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
TOKENPILOT_CONTEXT_SIMILARITY_THRESHOLD=0.08

# Optional provider routing fallbacks. Format: Provider:model,Provider:model
AI_ROUTING_LOW=
AI_ROUTING_MEDIUM=
AI_ROUTING_HIGH=

# Frontend build/runtime configuration (set in Frontend/.env.local when needed)
VITE_API_URL=
VITE_DEV_SERVER_URL=
