# Copy to .env; replace REQUIRED values. Never commit .env.

# PostgreSQL / Compose
POSTGRES_DB=tokenpilot
POSTGRES_USER=tokenpilot
POSTGRES_PASSWORD=REQUIRED-long-random-password
DATABASE_URL=postgresql+psycopg2://tokenpilot:REQUIRED-long-random-password@postgres:5432/tokenpilot

# Authentication
SECRET_KEY=REQUIRED-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10
INVITATION_EXPIRE_DAYS=7

# Stable Fernet key for encrypted provider API keys
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=REQUIRED-stable-fernet-key

# SMTP (required for OTP, invitations, password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=notifications@example.com
SMTP_PASSWORD=REQUIRED
FRONTEND_URL=http://localhost

# Empty keeps the frontend same-origin through Nginx
VITE_API_URL=
PORT=80
TOKENPILOT_RESPONSE_CACHE_PATH=/app/data/response_cache.sqlite3
AI_ROUTING_LOW=
AI_ROUTING_MEDIUM=
AI_ROUTING_HIGH=
